function avg(data,a,b){
  let s=0,n=0;for(let i=a;i<b&&i<data.length;i++){s+=data[i];n++}return n?s/n/255:0;
}

function readAudio(){
  if(!analyser)return smooth;
  const freq=new Uint8Array(analyser.frequencyBinCount);
  analyser.getByteFrequencyData(freq);
  const bins=freq.length;
  const bass=avg(freq,1,Math.max(2,Math.floor(bins*.035)));
  const mids=avg(freq,Math.floor(bins*.035),Math.floor(bins*.24));
  const highs=avg(freq,Math.floor(bins*.24),Math.floor(bins*.72));
  let e=0;for(const v of freq)e+=v;e=e/(freq.length*255);
  let flux=0;
  if(prevSpectrum){for(let i=0;i<freq.length;i++)flux+=Math.max(0,freq[i]-prevSpectrum[i]);flux/=freq.length*70}
  prevSpectrum=freq;
  const raw={energy:Math.min(1,e*4.8),bass:Math.min(1,bass*3.7),mids:Math.min(1,mids*3.9),highs:Math.min(1,highs*4.4),onset:Math.min(1,flux*2.4)};
  smooth.energy=smooth.energy*.90+raw.energy*.10;
  smooth.bass=smooth.bass*.92+raw.bass*.08;
  smooth.mids=smooth.mids*.90+raw.mids*.10;
  smooth.highs=smooth.highs*.82+raw.highs*.18;
  smooth.onset=Math.max(raw.onset,smooth.onset*.72);
  return smooth;
}

function loop(now){
  const dt=Number.isFinite(now-last)?Math.max(0,Math.min((now-last)/1000,.05)):0;
  last=now;
  try{
    runtime.setAudio(readAudio());
    runtime.frame(dt);
  }catch(error){
    console.error("VSpace frame error:",error);
  }
  raf=requestAnimationFrame(loop);
}
raf=requestAnimationFrame(loop);

function ensureAudioGraph(){
  if(audioCtx)return;
  audioCtx=new (window.AudioContext||window.webkitAudioContext)();
  analyser=audioCtx.createAnalyser();analyser.fftSize=2048;analyser.smoothingTimeConstant=.72;
}

function resetAnalysis(){
  prevSpectrum=null;
  smooth={energy:0,bass:0,mids:0,highs:0,onset:0};
}

function disconnectInput(){
  source?.disconnect();source=null;
  fileSource?.disconnect();
  analyser?.disconnect();
  micStream?.getTracks().forEach(t=>t.stop());micStream=null;
  graphMode=null;
  resetAnalysis();
}

function connectFile(){
  ensureAudioGraph();
  if(graphMode==="file")return;
  disconnectInput();
  // Reuse one element source for the element's lifetime, including file changes.
  if(!fileSource)fileSource=audioCtx.createMediaElementSource(fileAudio);
  if(!fileDestination)fileDestination=audioCtx.createMediaStreamDestination();
  fileSource.connect(analyser);
  analyser.connect(audioCtx.destination);
  analyser.connect(fileDestination);
  graphMode="file";
}

function updateAudioControls(){
  const fileMode=audioSource.value==="file";
  const playing=fileMode&&fileURL&&!fileAudio.paused&&!fileAudio.ended;
  audioFileControls.classList.toggle("hidden",!fileMode);
  previewButton.classList.toggle("hidden",fileMode);
  filePlayback.classList.toggle("hidden",!fileURL);
  audioSource.disabled=recordingBusy;
  audioFileInput.disabled=recordingBusy;
  playPauseAudioButton.disabled=!fileURL||filePending;
  playPauseAudioButton.textContent=playing?"❚❚":"▶";
  playPauseAudioButton.setAttribute("aria-label",playing?"Pause audio":"Play audio");
  audioSeek.disabled=!fileURL||!Number.isFinite(fileAudio.duration);
  previewButton.textContent=micStream||micPending?"STOP LIVE PREVIEW":"START LIVE PREVIEW";
  recordButton.disabled=recordingBusy?recorder?.state!=="recording":!(fileMode?playing:micStream);
  liveBadge.textContent=playing||micStream?"LIVE":fileMode&&fileURL?"PAUSED":"READY";
}

async function startPreview(){
  if(audioSource.value!=="microphone")return;
  if(micStream||micPending)return stopPreview();
  const epoch=++sourceEpoch;
  let stream=null;
  micPending=true;updateAudioControls();
  try{
    ensureAudioGraph();
    await audioCtx.resume();
    if(epoch!==sourceEpoch)return;
    stream=await navigator.mediaDevices.getUserMedia({audio:{echoCancellation:false,noiseSuppression:false,autoGainControl:false},video:false});
    if(epoch!==sourceEpoch){stream.getTracks().forEach(t=>t.stop());return;}
    disconnectInput();
    micStream=stream;
    source=audioCtx.createMediaStreamSource(micStream);
    source.connect(analyser);graphMode="microphone";
    stageMessage.classList.add("hidden");
    statusText.textContent="Listening through your microphone. Audio stays on this device.";
  }catch(error){
    stream?.getTracks().forEach(t=>t.stop());
    if(epoch===sourceEpoch){
      disconnectInput();
      statusText.textContent="Microphone preview could not start. "+error.message;
    }
  }finally{
    if(epoch===sourceEpoch){micPending=false;updateAudioControls();}
  }
}

function stopPreview(){
  if(recorder&&recorder.state==="recording")stopRecording();
  ++sourceEpoch;micPending=false;filePending=false;
  fileAudio.pause();
  disconnectInput();
  updateAudioControls();
  statusText.textContent="Live preview stopped.";
}

async function playFile(){
  if(audioSource.value!=="file"||!fileURL||filePending)return;
  const epoch=++sourceEpoch;
  filePending=true;updateAudioControls();
  try{
    connectFile();
    await audioCtx.resume();
    if(epoch!==sourceEpoch)return;
    await fileAudio.play();
    if(epoch!==sourceEpoch)return;
    stageMessage.classList.add("hidden");
    statusText.textContent="Playing your local audio file. Nothing is uploaded.";
  }catch(error){
    if(epoch===sourceEpoch)statusText.textContent="Audio file could not play. Choose a browser-supported audio file. "+error.message;
  }finally{
    if(epoch===sourceEpoch){filePending=false;updateAudioControls();}
  }
}

function formatAudioTime(seconds){
  if(!Number.isFinite(seconds)||seconds<0)return "0:00";
  const total=Math.floor(seconds);
  const minutes=Math.floor(total/60);
  const secs=total%60;
  return minutes+":"+String(secs).padStart(2,"0");
}

function updateAudioTimeline(){
  const duration=Number.isFinite(fileAudio.duration)?fileAudio.duration:0;
  const current=Number.isFinite(fileAudio.currentTime)?fileAudio.currentTime:0;
  audioSeek.max=String(duration);
  audioSeek.value=String(Math.min(current,duration||0));
  audioCurrentTime.textContent=formatAudioTime(current);
  audioDuration.textContent=formatAudioTime(duration);
}

previewButton.addEventListener("click",startPreview);

playPauseAudioButton.addEventListener("click",()=>{
  if(!fileURL||filePending)return;
  if(!fileAudio.paused&&!fileAudio.ended){
    ++sourceEpoch;filePending=false;
    fileAudio.pause();
    updateAudioControls();
    statusText.textContent="Audio file paused.";
  }else{
    playFile();
  }
});

audioSeek.addEventListener("input",()=>{
  if(!fileURL||!Number.isFinite(fileAudio.duration))return;
  fileAudio.currentTime=Number(audioSeek.value);
  updateAudioTimeline();
});

for(const event of ["play","pause","ended"]){
  fileAudio.addEventListener(event,()=>{
    updateAudioControls();
    updateAudioTimeline();
  });
}

for(const event of ["loadedmetadata","durationchange","timeupdate"]){
  fileAudio.addEventListener(event,updateAudioTimeline);
}

fileAudio.addEventListener("error",()=>{
  if(audioSource.value!=="file"||!fileURL)return;
  fileAudio.pause();updateAudioControls();
  statusText.textContent="This audio file could not be loaded. Choose another audio file.";
});

audioSource.addEventListener("change",()=>{
  stopPreview();
  stageMessage.querySelector("span").textContent=audioSource.value==="file"?"Choose a local audio file, then press Play.":"Allow microphone access to begin.";
  statusText.textContent=audioSource.value==="file"?"Choose a local audio file to preview. Nothing is uploaded.":"Press Start Live Preview to use your microphone.";
});

audioFileInput.addEventListener("change",()=>{
  const file=audioFileInput.files[0];
  if(!file||recordingBusy||audioSource.value!=="file")return;
  ++sourceEpoch;filePending=false;
  fileAudio.pause();
  fileAudio.removeAttribute("src");fileAudio.load();
  if(fileURL)URL.revokeObjectURL(fileURL);
  fileURL=URL.createObjectURL(file);
  fileAudio.src=fileURL;fileAudio.load();
  updateAudioTimeline();
  resetAnalysis();updateAudioControls();
  statusText.textContent="Audio file ready. Press Play to preview before recording.";
});
updateAudioControls();

