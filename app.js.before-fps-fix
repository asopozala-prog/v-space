function bestMime(){
  const choices=["video/webm;codecs=vp9,opus","video/webm;codecs=vp8,opus","video/webm"];
  return choices.find(x=>window.MediaRecorder&&MediaRecorder.isTypeSupported(x))||"";
}

// Export-only dependency: pinned, single-threaded WASM; fetched on MP4 click only.
const FFMPEG_MODULE="https://cdn.jsdelivr.net/npm/@ffmpeg/ffmpeg@0.12.15/dist/esm";
const FFMPEG_CORE="https://cdn.jsdelivr.net/npm/@ffmpeg/core@0.12.10/dist/esm";

function recordingBasename(){
  const slugs={sand:"sand-moon","sand-floor":"moon-floor","network-field":"network-field","network-journey":"network-journey"};
  const date=new Date(),pad=n=>String(n).padStart(2,"0");
  const day=[date.getFullYear(),pad(date.getMonth()+1),pad(date.getDate())].join("-");
  const time=[pad(date.getHours()),pad(date.getMinutes()),pad(date.getSeconds())].join("-");
  return `V_space_${slugs[selected]}_${day}_${time}`;
}

function resetExports(){
  ++exportRevision;
  mp4Job?.cancel();mp4Job=null;
  if(webmURL)URL.revokeObjectURL(webmURL);
  if(mp4URL)URL.revokeObjectURL(mp4URL);
  webmURL=null;mp4URL=null;mp4File=null;
  downloadWebmButton.removeAttribute("href");
  downloadButton.disabled=false;downloadButton.textContent="DOWNLOAD MP4";
}

function downloadMP4File(){
  const link=document.createElement("a");
  link.href=mp4URL;link.download=mp4File.name;
  document.body.append(link);link.click();link.remove();
}

async function exportMP4(){
  if(!recordFile||mp4Job)return;
  if(mp4File){downloadMP4File();return;}
  const input=recordFile,revision=exportRevision;
  let encoder=null,workerURL=null,timer=null,rejectDeadline,cancelled=false;
  const deadline=new Promise((_,reject)=>{rejectDeadline=reject;});
  const job={cancel(){cancelled=true;encoder?.terminate();rejectDeadline(new Error("Export cancelled or timed out."));}};
  mp4Job=job;
  downloadButton.disabled=true;downloadButton.textContent="PREPARING MP4…";
  statusText.textContent="Loading the MP4 converter. Your clip stays in this browser; WebM is available now.";
  const work=async()=>{
    const {FFmpeg}=await import(FFMPEG_MODULE+"/index.js?load="+(++mp4LoadAttempt));
    if(cancelled||revision!==exportRevision)throw new Error("Export cancelled.");
    encoder=new FFmpeg();
    // A local module-worker entry imports the pinned package without a build step.
    workerURL=URL.createObjectURL(new Blob([`import "${FFMPEG_MODULE}/worker.js";`],{type:"text/javascript"}));
    await encoder.load({classWorkerURL:workerURL,coreURL:FFMPEG_CORE+"/ffmpeg-core.js",wasmURL:FFMPEG_CORE+"/ffmpeg-core.wasm"});
    clearTimeout(timer);
    timer=setTimeout(()=>job.cancel(),10*60*1000);
    if(cancelled||revision!==exportRevision)throw new Error("Export cancelled.");
    downloadButton.textContent="CONVERTING MP4…";
    statusText.textContent="Converting to H.264 + AAC on this device. WebM remains available.";
    await encoder.writeFile("input.webm",new Uint8Array(await input.arrayBuffer()));
    const result=await encoder.exec([
      "-i","input.webm","-map","0:v:0","-map","0:a:0",
      "-c:v","libx264","-preset","ultrafast","-crf","22",
      "-vf","pad=ceil(iw/2)*2:ceil(ih/2)*2","-pix_fmt","yuv420p",
      "-c:a","aac","-b:a","192k","-movflags","+faststart","output.mp4"
    ]);
    if(result!==0)throw new Error("The encoder could not convert this clip.");
    // Explicit H.264/AAC encoders above; reject an invalid MP4 container.
    const data=await encoder.readFile("output.mp4");
    if(data.length<12||String.fromCharCode(...data.subarray(4,8))!=="ftyp")throw new Error("Invalid MP4 container.");
    return new File([data],input.name.replace(/\.webm$/,".mp4"),{type:"video/mp4"});
  };
  try{
    timer=setTimeout(()=>job.cancel(),90000);
    const output=await Promise.race([work(),deadline]);
    if(revision!==exportRevision)return;
    mp4File=output;mp4URL=URL.createObjectURL(output);
    statusText.textContent="MP4 ready: H.264 video and AAC audio. The original WebM is also available.";
    downloadMP4File();
  }catch(error){
    if(revision===exportRevision)statusText.textContent="MP4 conversion failed. Download WebM or retry MP4. "+error.message;
  }finally{
    clearTimeout(timer);encoder?.terminate();
    if(workerURL)URL.revokeObjectURL(workerURL);
    if(mp4Job===job){mp4Job=null;downloadButton.disabled=false;downloadButton.textContent="DOWNLOAD MP4";}
  }
}

downloadButton.addEventListener("click",exportMP4);

function formatClock(s){return "00:"+String(Math.max(0,s)).padStart(2,"0")}

async function startRecording(){
  const fileMode=audioSource.value==="file";
  if(recordingBusy||!window.MediaRecorder)return;
  if(fileMode?(!fileURL||fileAudio.paused||fileAudio.ended||graphMode!=="file"):!micStream)return;
  resultActions.classList.add("hidden");
  resetExports();recordFile=null;
  let canvasStream=null;
  try{
    canvasStream=canvas.captureStream(30);
    // File recording uses the clean graph output at the CURRENT playback time.
    const audioTracks=(fileMode?fileDestination.stream:micStream).getAudioTracks();
    const combined=new MediaStream([...canvasStream.getVideoTracks(),...audioTracks]);
    const mime=bestMime();
    if(!mime)throw new Error("This browser does not support WebM recording.");
    const basename=recordingBasename();
    recorder=new MediaRecorder(combined,mime?{mimeType:mime,videoBitsPerSecond:6000000}:undefined);
    const activeRecorder=recorder;
    recordedChunks=[];
    recorder.ondataavailable=e=>{if(e.data&&e.data.size)recordedChunks.push(e.data)};
    recorder.onstop=()=>{
      clearInterval(recordTimer);recordTimer=null;
      canvasStream.getTracks().forEach(t=>t.stop());
      const type=activeRecorder.mimeType||mime||"video/webm";
      recordFile=new File(recordedChunks,basename+".webm",{type});
      webmURL=URL.createObjectURL(recordFile);
      downloadWebmButton.href=webmURL;downloadWebmButton.download=recordFile.name;
      resultActions.classList.remove("hidden");
      recordingBusy=false;recorder=null;
      recordButton.textContent="RECORD 1 MINUTE";recordClock.textContent="01:00";
      updateAudioControls();
      statusText.textContent="Your WebM clip is ready. Choose Download MP4 to convert locally, or download WebM now.";
    };
    recorder.onerror=()=>{
      stopRecording();
      statusText.textContent="Recording failed. Please try again.";
    };
    recorder.start(1000);recordingBusy=true;
    recordButton.textContent="STOP RECORDING";updateAudioControls();
    let remaining=60;recordClock.textContent=formatClock(remaining);
    recordTimer=setInterval(()=>{
      remaining--;recordClock.textContent=formatClock(remaining);
      if(remaining<=0)stopRecording();
    },1000);
  }catch(error){
    canvasStream?.getTracks().forEach(t=>t.stop());
    recorder=null;recordingBusy=false;updateAudioControls();
    statusText.textContent="Recording could not start. "+error.message;
  }
}

function stopRecording(){
  clearInterval(recordTimer);recordTimer=null;
  if(recorder&&recorder.state==="recording")recorder.stop();
  updateAudioControls();
}

recordButton.addEventListener("click",()=>{
  if(recorder&&recorder.state==="recording")stopRecording();else startRecording();
});

shareButton.addEventListener("click",async()=>{
  if(!recordFile)return;
  try{
    if(navigator.canShare&&navigator.canShare({files:[recordFile]})){
      await navigator.share({files:[recordFile],title:"V🌔Space",text:"A one-minute V🌔Space live performance."});
    }else{
      statusText.textContent="Direct file sharing is not supported by this browser. Use Download Clip.";
    }
  }catch(error){
    if(error.name!=="AbortError")statusText.textContent="Share was not completed. "+error.message;
  }
});

window.addEventListener("resize",()=>runtime.resize());

window.addEventListener("pagehide",()=>{
  stopPreview();
  fileAudio.removeAttribute("src");fileAudio.load();
  if(fileURL)URL.revokeObjectURL(fileURL);
  fileURL=null;
  resetExports();
  fileDestination?.stream.getTracks().forEach(t=>t.stop());
  audioCtx?.close();
});
