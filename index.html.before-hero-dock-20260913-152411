<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#050505">
  <title>V🌔Space — Live Sound Space</title>
  <link rel="stylesheet" href="./styles.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="V Space">
      <img src="./vspace_corner_logo.svg" alt="V🌔Space">
    </a>
    <nav>
      <a href="#live">LIVE</a>
      <a href="#performance">PERFORMANCE</a>
      <a href="#about">ABOUT</a>
    </nav>
  </header>

  <main id="top">
    <section class="hero">
      <p class="eyebrow">MUSHROOM HOUSE 🍄 AI STUDIO</p>
      <h1 class="hero-wordmark" aria-label="V🌔Space">
<svg xmlns="http://www.w3.org/2000/svg"
     width="900" height="300" viewBox="0 0 900 300"
     id="piko_wordmark_rig" aria-hidden="true" focusable="false">
  <style>
    .rig-part {
      transform-box: fill-box;
      transform-origin: center;
    }
    .rig-vector {
      fill: var(--rig-fill, none);
      stroke: var(--rig-stroke, #EEF28B);
      stroke-linecap: round;
      stroke-linejoin: round;
    }
    .rig-symbol {
      fill: var(--rig-fill, currentColor);
      stroke: var(--rig-stroke, none);
    }
  </style>

  <!-- Transparent canvas: intentionally no background rect. -->

  <g id="V" class="rig-part" data-part="V"
     style="--rig-stroke:#EEF28B; --rig-fill:none;">
    <path class="rig-vector" d="M 82 58 C 74 83,80 112,94 134 L 145 236 C 151 248,165 248,172 235 L 224 72" stroke-width="22"/>
    <path class="rig-vector" d="M 84 60 L 62 76" stroke-width="10"/>
    <path class="rig-vector" d="M 151 237 C 160 251,176 249,183 232" stroke-width="8"/>
  </g>

  <g id="moon" class="rig-part" data-part="moon"
     style="--rig-fill:currentColor; --rig-stroke:none; color:initial;">
    <text class="rig-symbol" x="250" y="190"
          font-family="Apple Color Emoji, Apple Symbols, sans-serif"
          font-size="138" dominant-baseline="alphabetic">
      🌔
    </text>
  </g>

  <g id="S" class="rig-part" data-part="S"
     style="--rig-stroke:#EEF28B; --rig-fill:none;">
    <path class="rig-vector" d="M 470 86 C 438 57,381 63,369 100 C 356 141,397 156,433 161 C 470 166,489 185,478 216 C 464 255,401 259,365 225" stroke-width="18"/>
  </g>

  <g id="p" class="rig-part" data-part="p" transform="translate(500.00 145)"
     style="--rig-stroke:#EEF28B; --rig-fill:none;">
    <path class="rig-vector" d="M 0 0 L 0 122" stroke-width="11"/>
    <path class="rig-vector" d="M 1 6 C 18 -9,48 -6,49 18 C 50 42,22 53,1 40" stroke-width="11"/>
  </g>

  <g id="a" class="rig-part" data-part="a" transform="translate(567.00 155)"
     style="--rig-stroke:#EEF28B; --rig-fill:none;">
    <path class="rig-vector" d="M 0 28 C 0 7,28 0,39 16 C 49 32,33 47,15 44 C 5 42,0 36,0 28 M 40 5 L 40 46" stroke-width="9"/>
  </g>

  <g id="c" class="rig-part" data-part="c" transform="translate(632.00 155)"
     style="--rig-stroke:#EEF28B; --rig-fill:none;">
    <path class="rig-vector" d="M 34 13 C 17 1,0 11,0 29 C 0 47,19 54,35 44" stroke-width="9"/>
  </g>

  <g id="e" class="rig-part" data-part="e" transform="translate(693.00 155)"
     style="--rig-stroke:#EEF28B; --rig-fill:none;">
    <path class="rig-vector" d="M 0 29 C 21 26,38 24,45 22 C 39 3,9 2,2 23 C -4 43,16 56,41 43" stroke-width="9"/>
  </g>

  <metadata>
    reading=V🌔Space;
    moon_symbol=🌔;
    S_p_gap_em=0.06;
    p_a_gap_em=0.08;
    a_c_gap_em=0.07;
    c_e_gap_em=0.07;
    rig_parts=V,moon,S,p,a,c,e;
    canvas=transparent;
    status=programmable_rig_exact_geometry_not_locked
  </metadata>

  <!-- Moon phase motion: complete cycles, then hold on 🌔. -->
</svg>
      </h1>
      <p class="hero-copy">A live visual-space instrument for sound.</p>
      <a class="hero-action" href="#live">ENTER LIVE SPACE ↓</a>
    </section>

    <section id="live" class="live-section">
      <div class="section-heading">
        <p class="eyebrow">LIVE CLOUD INSTRUMENT</p>
        <h2>Choose a Space</h2>
        <p>Each experience has its own trusted visual and spatial behavior. Your sound drives it live.</p>
      </div>

      <div class="family-grid">
        <article class="family">
          <div class="family-title">
            <span>01</span>
            <h3>Sand Moon</h3>
          </div>
          <div class="experience-grid">
            <button class="experience-card selected" data-space="sand">
              <strong>Moon</strong>
              <span>Particle Moon / spatial observation</span>
            </button>
            <button class="experience-card" data-space="sand-floor">
              <strong>Moon + Floor</strong>
              <span>Particle Moon / reactive floor environment</span>
            </button>
          </div>
        </article>

        <article class="family">
          <div class="family-title">
            <span>02</span>
            <h3>Network Constellation</h3>
          </div>
          <div class="experience-grid">
            <button class="experience-card" data-space="network-field">
              <strong>Field</strong>
              <span>Persistent sound-reactive network</span>
            </button>
            <button class="experience-card" data-space="network-journey">
              <strong>Journey</strong>
              <span>Travel through the constellation space</span>
            </button>
          </div>
        </article>
      </div>

      <section class="instrument">
        <div class="stage-wrap">
          <canvas id="spaceCanvas" width="900" height="900" aria-label="V Space live preview"></canvas>
          <div id="stageMessage" class="stage-message">
            <strong id="spaceName">Sand Moon</strong>
            <span>Allow microphone access to begin.</span>
          </div>
          <div class="live-badge" id="liveBadge">READY</div>
        </div>

        <div class="instrument-panel">
          <div class="now-playing">
            <span>SPACE</span>
            <strong id="selectedLabel">Sand Moon — Moon</strong>
          </div>

          <div class="audio-source">
            <label for="audioSource">LIVE PREVIEW AUDIO</label>
            <select id="audioSource">
              <option value="microphone">LIVE / PLAYING AUDIO</option>
              <option value="file">AUDIO FILE</option>
            </select>
            <p id="audioSourceHelp" class="audio-source-help">Uses your microphone to catch live sound or music playing through your speakers.</p>
          </div>
          <div id="audioFileControls" class="audio-file-controls hidden">
            <label for="audioFileInput">CHOOSE AUDIO FILE</label>
            <input id="audioFileInput" type="file" accept="audio/*">
            <div id="filePlayback" class="file-playback hidden">
              <div class="audio-player">
                <button id="playPauseAudioButton" class="audio-player-toggle" type="button" aria-label="Play audio">▶</button>
                <span id="audioCurrentTime" class="audio-player-time">0:00</span>
                <input id="audioSeek" class="audio-player-seek" type="range" min="0" max="0" step="0.01" value="0" aria-label="Audio timeline">
                <span id="audioDuration" class="audio-player-time">0:00</span>
              </div>
            </div>
          </div>

          <button id="previewButton" class="primary">START LIVE PREVIEW</button>
          <button id="fullscreenButton">FULL SCREEN</button>

          <div class="record-row">
            <button id="recordButton" disabled>RECORD 1 MINUTE</button>
            <span id="recordClock">01:00</span>
          </div>

          <div id="resultActions" class="result-actions hidden">
            <button id="downloadButton" type="button">DOWNLOAD MP4</button>
            <a id="downloadWebmButton" download>DOWNLOAD WEBM</a>
            <button id="shareButton">SHARE</button>
          </div>

          <p id="statusText" class="status">Nothing is uploaded. Live audio and recording stay in this browser.</p>
        </div>
      </section>
    </section>

    <section id="performance" class="performance-section">
      <p class="eyebrow">SOUND ART × V🌔SPACE</p>
      <div class="performance-copy">
        <h2>Live performance</h2>
        <p>V🌔Space began through a shared sound-art performance: sound, Sand Moon, floor and spatial movement becoming one live entity.</p>
        <p class="muted">Artist, venue and performance information can be added here without changing the live instrument.</p>
      </div>
    </section>

    <section id="about" class="about-section">
      <p class="eyebrow">VOCABULARY</p>
      <div class="about-grid">
        <h2>One sound.<br>Many spatial relationships.</h2>
        <p>The first public vocabulary contains two Space families and four authored experiences: fixed observation, camera travel, particle form, and layered environment. V🌔Space reacts to music rather than decorating it.</p>
      </div>
    </section>
  </main>

  <footer>
    <span>V🌔Space</span>
    <span>Mushroom House 🍄 AI Studio</span>
  </footer>

  <script src="./hero-animation.js"></script>
  <script src="./vspace-runtime.js"></script>
  <script src="./app.js"></script>
</body>
</html>
