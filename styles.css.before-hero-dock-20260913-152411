:root{
  --bg:#050505;--panel:#0b0b0b;--line:#242424;--text:#eee8dc;--muted:#918b80;
  --soft:#151515;--accent:#d8c59a
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif}
a{color:inherit;text-decoration:none}
button{font:inherit}
.site-header{height:72px;padding:14px 28px;display:flex;align-items:center;justify-content:space-between;position:fixed;top:0;left:0;right:0;z-index:20;background:linear-gradient(#050505 40%,transparent);pointer-events:none}
.site-header>*{pointer-events:auto}
.brand img{height:42px;width:auto;display:block}
nav{display:flex;gap:22px;font-size:11px;letter-spacing:.16em}
.hero{min-height:100svh;display:flex;flex-direction:column;justify-content:center;padding:100px max(7vw,28px);border-bottom:1px solid var(--line)}
.eyebrow{font-size:10px;letter-spacing:.22em;color:var(--muted);margin:0 0 24px}
/* The inline native SVG retains its 900:300 viewBox and exact rig geometry. */
.hero{overflow:hidden}
.hero .hero-wordmark{width:min(100%,1000px);margin:0;line-height:0}
.hero-wordmark svg{display:block;width:100%;height:auto;overflow:visible}
.hero-wordmark .hero-arrival{transform-box:fill-box;transform-origin:center}
.hero-copy{font-size:clamp(18px,2.2vw,30px);max-width:580px;margin:34px 0 56px;color:#c8c1b6}
.hero-action{font-size:12px;letter-spacing:.16em;border-bottom:1px solid #706b62;padding-bottom:8px;width:max-content}
.live-section,.performance-section,.about-section{padding:110px max(6vw,24px)}
.section-heading{max-width:760px;margin-bottom:60px}
.section-heading h2,.performance-copy h2,.about-grid h2{font-size:clamp(38px,6vw,82px);font-weight:400;letter-spacing:-.045em;margin:0 0 20px}
.section-heading>p:last-child,.performance-copy p,.about-grid p{color:#aaa399;line-height:1.6;font-size:16px}
.family-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:72px}
.family{border-top:1px solid var(--line);padding-top:18px}
.family-title{display:flex;gap:18px;align-items:baseline;margin-bottom:22px}
.family-title span{font-size:10px;color:var(--muted)}
.family-title h3{font-size:22px;font-weight:400;margin:0}
.experience-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.experience-card{appearance:none;text-align:left;border:1px solid var(--line);background:var(--panel);color:var(--text);padding:22px;min-height:120px;cursor:pointer;transition:.2s}
.experience-card:hover,.experience-card.selected{border-color:#8d826c;background:#11100e}
.experience-card strong{display:block;font-size:15px;margin-bottom:10px;font-weight:500}
.experience-card span{color:var(--muted);font-size:12px;line-height:1.45}
.instrument{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(280px,.5fr);gap:32px;align-items:start}
.stage-wrap{position:relative;width:100%;aspect-ratio:1;background:#000;border:1px solid #161616;overflow:hidden}
#spaceCanvas{display:block;width:100%;height:100%;background:#000}
.stage-message{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;pointer-events:none;text-align:center}
.stage-message strong{font-size:22px;font-weight:400}
.stage-message span{font-size:12px;color:var(--muted)}
.stage-message.hidden{display:none}
.live-badge{position:absolute;top:16px;right:16px;font-size:10px;letter-spacing:.16em;color:#999;background:#090909aa;border:1px solid #2a2a2a;padding:8px 10px}
.instrument-panel{position:sticky;top:96px;border-top:1px solid var(--line);padding-top:18px}
.now-playing{display:flex;flex-direction:column;gap:6px;margin-bottom:30px}
.now-playing span{font-size:9px;letter-spacing:.2em;color:var(--muted)}
.now-playing strong{font-weight:400;font-size:20px}
.primary,#fullscreenButton,.record-row button,.result-actions a,.result-actions button{width:100%;border:1px solid #5b554b;background:transparent;color:var(--text);padding:16px 14px;cursor:pointer;letter-spacing:.1em;font-size:11px}
.primary{background:var(--text);color:#090909;border-color:var(--text);margin-bottom:10px}
#fullscreenButton{margin-bottom:10px}
.stage-wrap:fullscreen{
  width:100vw;
  height:100vh;
  aspect-ratio:auto;
  border:0;
  background:#000;
}
.stage-wrap:fullscreen #spaceCanvas{
  width:100%;
  height:100%;
  object-fit:contain;
}
button:disabled{opacity:.28;cursor:not-allowed}
.record-row{display:grid;grid-template-columns:1fr auto;gap:8px}
.record-row span{border:1px solid var(--line);padding:16px 13px;min-width:65px;text-align:center;font-variant-numeric:tabular-nums}
.result-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px}
.result-actions.hidden{display:none}
.status{font-size:11px;line-height:1.55;color:var(--muted);margin-top:18px}
.performance-section{border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 2fr;gap:60px}
.performance-copy{max-width:760px}
.performance-copy .muted{color:#726e67}
.about-section{border-top:1px solid var(--line)}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:50px}
.about-grid p{max-width:580px}
footer{border-top:1px solid var(--line);padding:30px max(6vw,24px);display:flex;justify-content:space-between;font-size:10px;letter-spacing:.12em;color:var(--muted)}
@media(max-width:820px){
  .family-grid,.instrument,.performance-section,.about-grid{grid-template-columns:1fr}
  .experience-grid{grid-template-columns:1fr 1fr}
  .instrument-panel{position:static}
  nav{display:none}
  .live-section,.performance-section,.about-section{padding-top:78px;padding-bottom:78px}
}
@media(max-width:520px){
  .site-header{padding-left:18px;padding-right:18px}
  .hero{padding-left:20px;padding-right:20px}
  .live-section,.performance-section,.about-section{padding-left:18px;padding-right:18px}
  .experience-grid{grid-template-columns:1fr}
  .family-grid{gap:38px}
}

.audio-source,.audio-file-controls{margin-bottom:14px}
.audio-source label,.audio-file-controls label{display:block;font-size:10px;letter-spacing:.12em;color:var(--muted);margin-bottom:8px}
.audio-source select{width:100%;padding:12px;background:var(--panel);color:var(--text);border:1px solid #5b554b;font:inherit;font-size:11px;letter-spacing:.1em}
#audioFileInput{display:block;width:100%;min-width:0;color:var(--muted);font-size:11px}
#audioFileInput::file-selector-button{padding:12px;border:1px solid #5b554b;background:transparent;color:var(--text);font:inherit;font-size:11px;cursor:pointer}
.audio-player{display:grid;grid-template-columns:36px auto 1fr auto;align-items:center;gap:10px;margin-top:14px}
.audio-player-toggle{width:36px;height:36px;padding:0;border:1px solid #5b554b;background:transparent;color:var(--text);font:inherit;font-size:14px;line-height:1;cursor:pointer}
.audio-player-toggle:disabled{opacity:.35;cursor:default}
.audio-player-time{font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums;min-width:32px}
.audio-player-seek{width:100%;min-width:0;cursor:pointer;accent-color:var(--text)}
.audio-player-seek:disabled{opacity:.35;cursor:default}
.audio-file-controls.hidden,.file-playback.hidden,#previewButton.hidden{display:none}

.audio-source-help{
  margin:8px 0 0;
  color:var(--muted);
  font-size:11px;
  line-height:1.5;
}

/* Performance template typography */
#performance .performance-copy h2{
  font-family:"Academy Engraved LET",serif;
  font-weight:400;
  color:#ffff00;
}

#performance .performance-copy p{
  font-family:"Andale Mono",monospace;
  font-weight:400;
  color:#ffffff;
}

#performance .performance-copy p.muted{
  color:#ffffff;
}

/* MP4 is the primary export; the original WebM remains directly downloadable. */
.result-actions #downloadButton{grid-column:1 / -1;background:var(--text);color:#090909;border-color:var(--text)}

/* Global V🌔Space typography system */
body{
  font-family:"Andale Mono",monospace;
  color:#ffffff;
}

h1,h2,h3,h4,h5,h6{
  font-family:"Academy Engraved LET",serif;
  font-weight:400;
  color:#ffff00;
}

p{
  font-family:"Andale Mono",monospace;
  color:#ffffff;
}

.muted{
  color:#ffffff;
}
